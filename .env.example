# ─────────────────────────────────────────────────────────────
# DOCS MEDIA — environment variables (copy to .env.local)
# ─────────────────────────────────────────────────────────────

# Production domain, no trailing slash. Drives canonical URLs, sitemap.xml,
# robots.txt, Open Graph and structured data. Defaults to
# https://www.connectdocsmedia.com when empty.
# Example: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=

# ── Enquiry form delivery (all optional; configure one or both) ──
# If neither is set, the form still validates and then hands the visitor off
# to WhatsApp with their message pre-filled.

# Option A — email through Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=          # comma-separated allowed
ENQUIRY_FROM_EMAIL=        # e.g. "DOCS MEDIA <enquiries@your-domain.com>" (verified sender)

# Option B — generic webhook (Make, Zapier, n8n, Google Apps Script…)
ENQUIRY_WEBHOOK_URL=

# ── Search engine verification (optional) ──
# Paste ONLY the token (the content="..." value) from Google Search Console's
# "HTML tag" method and Bing Webmaster Tools. Omitted from the page when empty.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
